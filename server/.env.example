# --- سرور ---
NODE_ENV=development
PORT=3000
TZ=Asia/Tehran

# --- پایگاه داده ---
DATABASE_URL=postgresql://repair_app:change-me-in-env@127.0.0.1:5432/repair_workshop
DB_POOL_MAX=10
DB_AUTO_MIGRATE=true

# --- امنیت ---
# حداقل ۳۲ نویسه تصادفی؛ در سرور واقعی حتماً تغییر دهید
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
COOKIE_SECURE=false
# اختیاری: راز اختصاصی رمزنگاری رمز/الگوی دستگاه (حداقل ۳۲ نویسه)
# در نبود مقدار، از JWT_SECRET استفاده می‌شود
# DEVICE_SECRET=

# --- فایل‌ها ---
# مسیر ذخیره تصاویر دستگاه‌ها روی سرور مرکزی
UPLOADS_DIR=./uploads

# --- ذخیره‌سازی فایل دستگاه‌ها ---
# ریشه پیش‌فرض پوشه بکاپ/ریکاوری؛ در تنظیمات «فایل و بکاپ» هم قابل تغییر است
# مثال ویندوز: STORAGE_ROOT=D:/RepairStorage  یا  \\REPAIR-SERVER\RepairStorage
STORAGE_ROOT=./storage

# --- پشتیبان‌گیری ---
BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
BACKUP_CRON_ENABLED=true
# عبارت عبور رمزنگاری نسخه‌های پشتیبان (AES-256-GCM). حداقل ۱۶ نویسه و کاملاً محرمانه.
# بدون این مقدار، ساخت نسخه رمزنگاری‌شده ممکن نیست و وضعیت هشدار نشان می‌دهد.
# BACKUP_PASSPHRASE=

# --- رابط کاربری (کلاینت توسعه) ---
# در حالت توسعه، Vite روی 3000 اجرا می‌شود؛ برای جلوگیری از تداخل، PORT را 3001 و
# DATABASE_URL را در صورت استفاده از scripts/dev-db.mjs به پورت 5597 تنظیم کنید.
