# --- سرور ---
NODE_ENV=development
PORT=3000
TZ=Asia/Tehran

# --- پایگاه داده ---
DATABASE_URL=postgresql://repair_app:change-me-in-env@127.0.0.1:5432/repair_workshop
DB_POOL_MAX=10
DB_AUTO_MIGRATE=true

# --- امنیت ---
# حداقل ۳۲ نویسه تصادفی؛ در سرور واقعی حتماً تغییر دهید
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
COOKIE_SECURE=false

# --- پشتیبان‌گیری ---
BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump
BACKUP_CRON_ENABLED=true

# --- رابط کاربری (کلاینت توسعه) ---
# در حالت توسعه، Vite روی 3000 اجرا می‌شود؛ برای جلوگیری از تداخل، PORT را 3001 و
# DATABASE_URL را در صورت استفاده از scripts/dev-db.mjs به پورت 5597 تنظیم کنید.
